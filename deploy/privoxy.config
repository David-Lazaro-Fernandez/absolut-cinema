# Puente HTTP → SOCKS5 para el scraper. urllib solo habla proxies HTTP y el cliente WARP de Cloudflare en modo
# proxy expone SOCKS5, así que Privoxy recibe en 127.0.0.1:8118 y reenvía todo al SOCKS5 de WARP (127.0.0.1:40000)
# resolviendo los nombres del lado de WARP. Con `toggle 0` Privoxy no filtra ni modifica nada: es un proxy plano.
# Lo instala deploy/install.sh en /etc/privoxy/config. Quién lo usa: scraper/http.py vía AC_EGRESS_PROXY.
confdir /etc/privoxy
logdir /var/log/privoxy
listen-address 127.0.0.1:8118
toggle 0
enable-remote-toggle 0
enable-edit-actions 0
forward-socks5t / 127.0.0.1:40000 .
