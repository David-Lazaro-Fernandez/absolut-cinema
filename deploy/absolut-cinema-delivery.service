[Unit]
Description=absolut-cinema: dulcería a domicilio de ambas cadenas en Rappi y DiDi Food
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=absolut
WorkingDirectory=/opt/absolut-cinema
EnvironmentFile=-/etc/absolut-cinema.env
ExecStart=/usr/bin/make -C /opt/absolut-cinema delivery
TimeoutStartSec=60min
Nice=10
StandardOutput=append:/opt/absolut-cinema/data/logs/systemd.out
StandardError=append:/opt/absolut-cinema/data/logs/systemd.out
