[Unit]
Description=absolut-cinema: planos de asientos de Cinépolis tras el inicio de cada función (asistencia final)
After=network-online.target warp-svc.service privoxy.service
Wants=network-online.target
# Escribe en data/snapshots.db (SQLite en WAL, un escritor a la vez): si coincide con una captura, sqlite3
# espera el `timeout` de store.connect().

[Service]
Type=oneshot
User=absolut
WorkingDirectory=/opt/absolut-cinema
EnvironmentFile=-/etc/absolut-cinema.env
ExecStart=/usr/bin/make -C /opt/absolut-cinema -k seats
TimeoutStartSec=20min
Nice=5
StandardOutput=append:/opt/absolut-cinema/data/logs/systemd.out
StandardError=append:/opt/absolut-cinema/data/logs/systemd.out
