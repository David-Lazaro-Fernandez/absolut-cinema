[Unit]
Description=absolut-cinema: dashboard Streamlit (solo localhost; Caddy lo expone)
After=network.target

[Service]
User=absolut
WorkingDirectory=/opt/absolut-cinema
EnvironmentFile=-/etc/absolut-cinema.env
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/opt/absolut-cinema/.venv/bin/streamlit run app.py \
  --server.address 127.0.0.1 --server.port 8501 --server.headless true \
  --server.enableCORS false --server.enableXsrfProtection true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
