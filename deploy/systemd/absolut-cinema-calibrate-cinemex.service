# Generado por `python3 -m jobs.units write` desde jobs/registry.py; no se edita a mano.
[Unit]
Description=absolut-cinema: Calibración del semáforo de Cinemex contra el plano público, 100 funciones por nivel (tope 60 por corrida)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=absolut
WorkingDirectory=/opt/absolut-cinema
EnvironmentFile=-/etc/absolut-cinema.env
ExecStart=/usr/bin/make -C /opt/absolut-cinema job KEY=calibrate-cinemex
TimeoutStartSec=25min
Nice=10
StandardOutput=append:/opt/absolut-cinema/data/logs/systemd.out
StandardError=append:/opt/absolut-cinema/data/logs/systemd.out
