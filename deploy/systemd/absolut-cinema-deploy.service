# Generado por `python3 -m jobs.units write` desde jobs/registry.py; no se edita a mano.
[Unit]
Description=absolut-cinema: Trae origin/stable, reinstala si cambió requirements, sincroniza unidades y reinicia el dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/absolut-cinema
EnvironmentFile=-/etc/absolut-cinema.env
ExecStart=/usr/bin/make -C /opt/absolut-cinema job KEY=deploy
TimeoutStartSec=15min
StandardOutput=append:/opt/absolut-cinema/data/logs/systemd.out
StandardError=append:/opt/absolut-cinema/data/logs/systemd.out
