# Generado por `python3 -m jobs.units write` desde jobs/registry.py; no se edita a mano.
[Unit]
Description=absolut-cinema: Preventas de ambas cadenas: panel de hasta 30 funciones por título en preventa, plano a diario
After=network-online.target warp-svc.service privoxy.service
Wants=network-online.target

[Service]
Type=oneshot
User=absolut
WorkingDirectory=/opt/absolut-cinema
EnvironmentFile=-/etc/absolut-cinema.env
ExecStart=/usr/bin/make -C /opt/absolut-cinema job KEY=presale
TimeoutStartSec=50min
Nice=10
StandardOutput=append:/opt/absolut-cinema/data/logs/systemd.out
StandardError=append:/opt/absolut-cinema/data/logs/systemd.out
