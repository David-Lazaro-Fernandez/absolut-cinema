[Unit]
Description=absolut-cinema: aforo de Cinépolis, día 1 de cada mes a las 04:07

[Timer]
# Hora de America/Mexico_City (zona del servidor, ver install.sh). Minutos :07 para no coincidir con un snapshot.
OnCalendar=*-*-01 04:07:00
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
