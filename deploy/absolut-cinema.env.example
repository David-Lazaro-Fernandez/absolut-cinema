# Copiar a /etc/absolut-cinema.env (chmod 600). Lo leen los units de systemd y backup.sh.
# Claves de las APIs (solo si rotaron; por defecto se usan las de scraper/config.py).
#CINEPOLIS_API_KEY=
#CINEMEX_CONSUMER_KEY=
#CINEMEX_BASE_URL=https://api.cinemex.com/rest/v2.37.2/

# Alcance de la captura de cartelera: nacional por defecto. Para acotar a una plaza (p. ej. una prueba):
#AC_CINEPOLIS_CITIES=cdmx
#AC_CINEMEX_STATES=8
# Plazas cuyas funciones entran al muestreo de planos de asientos (claves de scraper/plazas.py; por defecto cdmx).
#AC_SEATS_PLAZAS=cdmx,gdl,mty

# Salida por Cloudflare WARP (Privoxy → SOCKS5 de WARP) para los hosts que bloquean la IP de AWS. Lo configura
# install.sh; vacío = todo directo. Hosts por defecto: api-g.cinepolis.com (AC_EGRESS_PROXY_HOSTS, separados por coma).
AC_EGRESS_PROXY=http://127.0.0.1:8118
#AC_EGRESS_PROXY_HOSTS=api-g.cinepolis.com

# Respaldo: bucket S3 o DigitalOcean Spaces. Con Spaces, ENDPOINT es p. ej.
# https://nyc3.digitaloceanspaces.com y las credenciales van en ~/.aws/credentials del usuario absolut.
BACKUP_BUCKET=s3://absolut-cinema-backups
#BACKUP_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Acceso al dashboard (auth/): cuentas y sesiones en su propia base SQLite. Por defecto data/app.db.
#AC_APP_DB=/opt/absolut-cinema/data/app.db
# Correo de invitación y restablecimiento: console (queda en data/logs/mail.log) o ses (Amazon SES con el rol de la
# instancia; AWS_REGION la lee boto3). El remitente debe ser una identidad verificada en SES.
#AC_MAIL_BACKEND=ses
#AC_MAIL_FROM=Absolut Cinema <no-responder@DOMINIO>
#AWS_REGION=us-east-1
# URL pública del dashboard: base de los enlaces del correo; con https la cookie de sesión lleva Secure.
#AC_BASE_URL=https://DOMINIO
